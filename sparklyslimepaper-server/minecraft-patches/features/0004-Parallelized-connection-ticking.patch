 public class ServerConnectionListener {
     private static final Logger LOGGER = LogUtils.getLogger();
@@ -248,21 +255,19 @@ public class ServerConnectionListener {
             // Spigot end
             Iterator<Connection> iterator = this.connections.iterator();
 
+            // Group connections by world
+            Map<ServerLevel, List<Connection>> connectionsByWorld = new HashMap<>();
+
             while (iterator.hasNext()) {
                 Connection connection = iterator.next();
                 if (!connection.isConnecting()) {
                     if (connection.isConnected()) {
-                        try {
-                            connection.tick();
-                        } catch (Exception var7) {
-                            if (connection.isMemoryConnection()) {
-                                throw new ReportedException(CrashReport.forThrowable(var7, "Ticking memory connection"));
-                            }
-
-                            LOGGER.warn("Failed to handle packet for {}", connection.getLoggableAddress(this.server.logIPs()), var7);
-                            Component component = Component.literal("Internal server error");
-                            connection.send(new ClientboundDisconnectPacket(component), PacketSendListener.thenRun(() -> connection.disconnect(component)));
-                            connection.setReadOnly();
+                        ServerPlayer player = connection.getPlayer();
+                        if (player != null && player.level() != null) {
+                            connectionsByWorld.computeIfAbsent(player.level(), k -> new ArrayList<>())
+                                    .add(connection);
+                        } else {
+                            this.tickConnection(connection);
                         }
                     } else {
                         if (connection.preparing) continue; // Spigot - Fix a race condition where a NetworkManager could be unregistered just before connection
@@ -271,6 +276,48 @@ public class ServerConnectionListener {
                     }
                 }
             }
+
+            // Submit one task per world
+            java.util.ArrayDeque<java.util.concurrent.Future<Void>> worldTasks = new java.util.ArrayDeque<>();
+            for (Map.Entry<ServerLevel, List<Connection>> entry : connectionsByWorld.entrySet()) {
+                ServerLevel world = entry.getKey();
+                List<Connection> worldConnections = entry.getValue();
+
+                worldTasks.add(MinecraftServer.getServer().levelThreadPool.submit(() -> {
+                    ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread currentThread =
+                            (ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread) Thread.currentThread();
+                    currentThread.currentlyTickingServerLevel = world;
+
+                    for (Connection connection : worldConnections) {
+                        this.tickConnection(connection);
+                    }
+                    return null;
+                }));
+            }
+
+            // Wait for completion
+            while (!worldTasks.isEmpty()) {
+                try {
+                    worldTasks.pop().get();
+                } catch (InterruptedException | ExecutionException e) {
+                    throw new RuntimeException(e);
+                }
+            }
+        }
+    }
+
+    private void tickConnection(Connection connection) {
+        try {
+            connection.tick();
+        } catch (Exception var7) {
+            if (connection.isMemoryConnection()) {
+                throw new ReportedException(CrashReport.forThrowable(var7, "Ticking memory connection"));
+            }
+
+            LOGGER.warn("Failed to handle packet for {}", connection.getLoggableAddress(this.server.logIPs()), var7);
+            Component component = Component.literal("Internal server error");
+            connection.send(new ClientboundDisconnectPacket(component), PacketSendListener.thenRun(() -> connection.disconnect(component)));
+            connection.setReadOnly();
         }
     }
 
